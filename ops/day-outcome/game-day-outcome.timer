[Unit]
Description=Game of the Day - check the day's outcome after the delivery window

[Timer]
# Delivery runs at 10:00 MSK; the first check gives 15 minutes of slack, then repeats
# so a missed day is not reported once and then forgotten (the 2026-09-20/21 incident
# went unnoticed for two days). --not-before makes an early manual run a no-op.
OnCalendar=*-*-* 10:15:00 Europe/Moscow
OnCalendar=*-*-* 11:15:00 Europe/Moscow
OnCalendar=*-*-* 13:15:00 Europe/Moscow
OnCalendar=*-*-* 17:15:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target
