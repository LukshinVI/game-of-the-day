[Unit]
Description=Game of the Day - independent check that today's game was delivered
After=network-online.target
Wants=network-online.target
# The check itself sends the alert (a Russian message naming what is missing), so
# OnFailure only fires when the check could not even do its job (exit code 2:
# unreadable database or the alert could not be sent).
OnFailure=game-backup-alert@%n.service

[Service]
Slice=game-of-the-day.slice
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
# Only to send its own alert; it never touches the messaging or delivery credentials.
EnvironmentFile=-/etc/game-of-the-day/ops-bot.env
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/ops/day_outcome_check.py
TimeoutStartSec=2min
# Exit 1 means "outcome not met, and the script already sent its own alert" - that must
# not also count as a unit failure, or OnFailure= would fire a second, generic alert for
# every ordinary miss. Exit 2 ("the check could not do its own job") is left as a real
# failure, so OnFailure= still covers that case.
SuccessExitStatus=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Read-only: PRAGMA query_only enforces this at the SQLite level too.
# SQLite in WAL mode: even a reader must write the -shm index next to the database,
# so the directory cannot be read-only. The script itself opens it with PRAGMA query_only.
ReadWritePaths=/srv/game-of-the-day/data
