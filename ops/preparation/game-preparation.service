[Unit]
Description=Game of the Day - prepare today's game (model proposes, code validates)
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service

[Service]
Slice=game-of-the-day.slice
# Runs the model CLI; observed peak ~265M.
MemoryHigh=450M
MemoryMax=600M
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
# game.env: CHILD_BIRTH_DATE. preparation.env: PREPARATION_BACKEND and the model
# credentials, readable by this unit only. ops-bot.env: alert credentials. voice.env:
# the Workers AI token, for the independent model (another provider than Claude).
EnvironmentFile=/etc/game-of-the-day/game.env
EnvironmentFile=/etc/game-of-the-day/preparation.env
EnvironmentFile=-/etc/game-of-the-day/ops-bot.env
EnvironmentFile=-/etc/game-of-the-day/voice.env
EnvironmentFile=-/etc/game-of-the-day/features.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The model CLI keeps its config and cache under HOME; give it a private state dir
# instead of the checkout.
StateDirectory=game-of-the-day
Environment=HOME=/var/lib/game-of-the-day
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/preparation/game_preparation.py prepare
# Up to three model attempts per child, each bounded by PREPARATION_MODEL_TIMEOUT (3 min);
# a provider that does not answer is skipped for the rest of the run after one timeout.
# A run for 50 children takes ~20 min, a bad day ~1 h. A run cut short is finished by the
# next timer.
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/game-of-the-day/data
