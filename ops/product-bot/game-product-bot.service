[Unit]
Description=Game of the Day - product Telegram bot (invites, onboarding, feedback)
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service

[Service]
Slice=game-of-the-day.slice
# Long-running; observed peak ~16M. A leak restarts this unit, not the host.
MemoryHigh=96M
MemoryMax=128M
Type=simple
# Its own identity, not the application user: this process faces the public. As a
# different uid it cannot read the environment (tokens) of the delivery, preparation
# or feedback processes through /proc. It shares only the database, through the
# gotd-data group (data/ is setgid gotd-data, the database file is 0660).
User=gotd-bot
Group=gotd-bot
SupplementaryGroups=gotd-data
WorkingDirectory=/srv/game-of-the-day
# Only the product bot token and the owner chat id. No VK, model or Cloudflare
# credentials: this process faces the public and never needs them.
EnvironmentFile=/etc/game-of-the-day/product-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/bot/product_bot.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/srv/game-of-the-day/data

[Install]
WantedBy=multi-user.target
