[Unit]
Description=Game of the Day - feedback insights: observations, child profile, a short reply
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service

[Service]
Slice=game-of-the-day.slice
# Runs the model CLI; observed peak ~265M.
MemoryHigh=450M
MemoryMax=600M
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
# game.env: CHILD_BIRTH_DATE. preparation.env: PREPARATION_BACKEND and the model
# credentials, readable by this unit only. ops-bot.env: alert credentials.
EnvironmentFile=/etc/game-of-the-day/game.env
EnvironmentFile=/etc/game-of-the-day/preparation.env
EnvironmentFile=-/etc/game-of-the-day/ops-bot.env
# Replies go through the channel the feedback came from: VK (game.env) or the product bot.
EnvironmentFile=-/etc/game-of-the-day/product-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The model CLI keeps its config and cache under HOME; give it a private state dir
# instead of the checkout.
StateDirectory=game-of-the-day
Environment=HOME=/var/lib/game-of-the-day
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/feedback/insights.py run
# A few small model calls per run at most (daily caps per child and in total).
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/game-of-the-day/data
