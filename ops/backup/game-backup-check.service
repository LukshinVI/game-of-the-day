[Unit]
Description=Game of the Day - verify the newest backup is fresh and valid
OnFailure=game-backup-alert@%n.service

[Service]
Type=oneshot
User=gotd
Group=gotd
ExecStart=/srv/game-of-the-day/ops/backup/game-backup.sh check
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/backups/game-of-the-day
