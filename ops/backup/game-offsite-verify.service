[Unit]
Description=Game of the Day - restore the newest off-site backup into a sandbox and check it
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service
ConditionPathExists=/etc/game-of-the-day/offsite.env

[Service]
Slice=game-of-the-day.slice
Type=oneshot
User=root
EnvironmentFile=/etc/game-of-the-day/offsite.env
UMask=0077
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only access to root's SSH key; nothing else under /root is needed.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=/var/backups/game-of-the-day /var/lib/game-of-the-day/offsite
# A backup that was never restored is a hope, not a backup.
ExecStart=/srv/game-of-the-day/ops/backup/offsite-git.sh verify
TimeoutStartSec=10min
