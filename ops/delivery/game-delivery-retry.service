[Unit]
Description=Game of the Day - retry a failed daily delivery (manual, started by the bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
# Same environment as game-delivery.service: the messaging credentials live in the
# delivery units only, never in the long-running bot.
EnvironmentFile=-/etc/game-of-the-day/game.env
EnvironmentFile=-/etc/game-of-the-day/ops-bot.env
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/delivery/game_delivery.py send-today --retry-failed
TimeoutStartSec=5min
