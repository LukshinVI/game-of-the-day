[Unit]
Description=Game of the Day - send today's prepared game
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service

[Service]
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
EnvironmentFile=/etc/game-of-the-day/game.env
EnvironmentFile=-/etc/game-of-the-day/ops-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/delivery/game_delivery.py send-today
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/game-of-the-day/data
