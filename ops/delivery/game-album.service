[Unit]
Description=Game of the Day - album of the month for parents
After=network-online.target
Wants=network-online.target
OnFailure=game-backup-alert@%n.service

[Service]
Slice=game-of-the-day.slice
Type=oneshot
User=gotd
Group=gotd
WorkingDirectory=/srv/game-of-the-day
EnvironmentFile=/etc/game-of-the-day/game.env
EnvironmentFile=-/etc/game-of-the-day/product-bot.env
EnvironmentFile=-/etc/game-of-the-day/features.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/game-of-the-day/src/ops/monthly_album.py run
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/game-of-the-day/data
