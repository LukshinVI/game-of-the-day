# Copy to a local .env (or a root-only EnvironmentFile on the host) and fill in
# environment-specific values. Never commit real credentials or identifiers.
# Names below are the variables the code actually reads.

# --- Feedback storage (src/feedback/storage.py) ---
# Optional: defaults to data/game-of-the-day.db under the repository root.
# FEEDBACK_DB_PATH=./data/game-of-the-day.db

# --- Feedback queue consumer (src/feedback/queue_consumer.py) ---
# Cloudflare Queues HTTP pull; use a token scoped to the queues only.
CF_ACCOUNT_ID=<account-id>
CF_STORAGE_QUEUE_ID=<queue-id>
CF_QUEUE_API_TOKEN=<token>

# --- Preparation (src/preparation/game_preparation.py) ---
# Child's birth date; the age for each game is computed from it on the delivery date.
CHILD_BIRTH_DATE=<YYYY-MM-DD>
# Model backend: claude (default) or codex, and its credentials.
PREPARATION_BACKEND=claude
# PREPARATION_CLAUDE_MODEL=sonnet            # chosen by the selection evals
# PREPARATION_MODEL_TIMEOUT=600
# PREPARATION_FALLBACK_MODEL=haiku           # same gate; empty disables it
# PREPARATION_DAILY_BUDGET_USD=6             # then the library of validated games
# PREPARATION_REVIEW_MODEL=haiku             # safety reviewer after the gate; empty = off
# INSIGHTS_MODEL=haiku                       # feedback observations
# INSIGHTS_PER_CHILD_PER_DAY=3
# INSIGHTS_GLOBAL_PER_DAY=60
CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
# ANTHROPIC_API_KEY=<key>   (alternative to the OAuth token)

# --- Delivery (src/delivery/game_delivery.py) ---
VK_TOKEN=<token>
# Single-child mode only; with children configured, recipients live in the database.
VK_PEER_ID=<recipient-id>
# Product bot for the Telegram channel (not the ops bot).
# GAME_TELEGRAM_BOT_TOKEN=<token>
# GAME_BOT_OWNER_ID=<owner telegram user id>   # /invite and /members in the product bot
# GAME_MAX_CHILDREN_PER_CHAT=3
# GAME_MAX_ACTIVE_CHILDREN=50
# GAME_MAX_FEEDBACK_PER_DAY=20

# --- Ops alerts (src/ops/notifier.py) ---
TELEGRAM_BOT_TOKEN=<token>
TELEGRAM_CHAT_ID=<chat-id>

# --- Cloudflare Worker ---
# Set with `wrangler secret put`, not in this file:
# VK_GROUP_ID, VK_CALLBACK_SECRET, VK_CONFIRMATION_CODE, VK_PROD_PEER_ID, VK_TEST_PEER_ID

# --- Game cards (src/delivery/cards.py) ---
# 1 = a skill picture above the game text (Telegram link preview, VK photo attachment).
# The VK community key then needs the Photos permission. Off when unset.
# GAME_CARDS=1
# Optional: where Telegram fetches the pictures (defaults to the public repository).
# CARD_BASE_URL=https://raw.githubusercontent.com/LukshinVI/game-of-the-day/main/assets/cards

# --- Holiday greetings (src/delivery/greetings.py) ---
# 1 = the 2.0 full-year birthday text and picture. Public holidays are greeted by posts
# on the community wall, not in the game message. Off when unset (the older birthday texts).
# GAME_HOLIDAYS=1

# --- Reaction buttons (src/feedback/buttons.py) ---
# 1 = 👍/👎 and easy / just right / hard buttons under every game; a tap updates the
# child's profile without a model. Off when unset (a press on an old button still counts).
# GAME_BUTTONS=1

# --- Theme of the month (src/feedback/month_theme.py) ---
# 1 = families may pick what to play more of this month («тема», /theme); selection
# trains it about every other day; the digest names only warm moments. Off when unset.
# GAME_MONTH_THEME=1

# --- Voice feedback (src/feedback/voice.py) ---
# 1 = voice messages are transcribed by Whisper on Cloudflare Workers AI and kept as
# text only. Needs a token with Workers AI permission. Set in the env of the feedback
# consumer (VK) and of the product bot (Telegram). Off when unset.
# GAME_VOICE=1
# CF_AI_TOKEN=<token>
# CF_ACCOUNT_ID=<account-id>
# VOICE_MODEL=@cf/openai/whisper-large-v3-turbo

# --- Feedback in context (src/feedback/insights.py) ---
# 1 = the analyzer sees the child's recent games and observations (attach to an earlier
# game, where the family plays, recent trend, corrections); test = test children only.
# GAME_FEEDBACK_CONTEXT=1

# --- Parents' digest (src/ops/weekly_digest.py) ---
# GAME_DIGEST_PULSE=1             # «полезно ли?» 1-5 on the third Sunday of a month
# GAME_DIGEST_STAR_REQUEST=1      # one-time request to star the repository
# GAME_NEWS_LINK=<wall post url>  # link under the news items (src/ops/news.json)

# --- Album of the month (src/ops/monthly_album.py, needs python3-pil) ---
# GAME_ALBUM=1

# --- Safety reviewer tiers (src/preparation/review.py) ---
# 1 = a missing caution is added to the game, only a hazard in the activity rejects it.
# PREPARATION_REVIEW_TIERS=1
