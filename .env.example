# Copy to a local .env (or a root-only EnvironmentFile on the host) and fill in
# environment-specific values. Never commit real credentials or identifiers.
# Names below are the variables the code actually reads.

# --- Feedback storage (src/feedback/storage.py) ---
# Optional: defaults to data/game-of-the-day.db under the repository root.
# FEEDBACK_DB_PATH=./data/game-of-the-day.db

# --- Feedback queue consumer (src/feedback/queue_consumer.py) ---
# Cloudflare Queues HTTP pull; use a token scoped to the queues only.
CF_ACCOUNT_ID=<account-id>
CF_STORAGE_QUEUE_ID=<queue-id>
CF_ENRICHED_QUEUE_ID=<queue-id>
CF_QUEUE_API_TOKEN=<token>

# --- Preparation (src/preparation/game_preparation.py) ---
# Child's birth date; the age for each game is computed from it on the delivery date.
CHILD_BIRTH_DATE=<YYYY-MM-DD>
# Model backend: claude (default) or codex, and its credentials.
PREPARATION_BACKEND=claude
# PREPARATION_CLAUDE_MODEL=opus
# PREPARATION_MODEL_TIMEOUT=600
CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
# ANTHROPIC_API_KEY=<key>   (alternative to the OAuth token)

# --- Delivery (src/delivery/game_delivery.py) ---
VK_TOKEN=<token>
VK_PEER_ID=<recipient-id>

# --- Ops alerts (src/ops/notifier.py) ---
TELEGRAM_BOT_TOKEN=<token>
TELEGRAM_CHAT_ID=<chat-id>

# --- Cloudflare Worker ---
# Set with `wrangler secret put`, not in this file:
# VK_GROUP_ID, VK_CALLBACK_SECRET, VK_CONFIRMATION_CODE, VK_PROD_PEER_ID, VK_TEST_PEER_ID
