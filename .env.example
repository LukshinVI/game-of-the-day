# Copy to a local .env file and provide environment-specific values.
# Never commit real credentials or production identifiers.

APP_ENV=development
APP_TIMEZONE=Europe/Moscow

# Durable storage
DATABASE_PATH=./data/game-of-the-day.sqlite

# Messaging transport
MESSAGING_API_TOKEN=<token>
MESSAGING_RECIPIENT_ID=<recipient-id>

# Feedback API
FEEDBACK_API_BASE_URL=https://api.<project-domain>
FEEDBACK_API_TOKEN=<token>

# Cloudflare / AI configuration
AI_MODEL=<provider-model-id>
